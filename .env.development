# Loaded by `npm run dev` only. The room API's address is public (it is
# baked into the production bundle too), so it is committed like
# .env.production. Without this, dev has no bot and the Kowen board and
# finds switch themselves off. twigo-bot allows localhost:5173 and :4173.
VITE_BOT_API_URL=https://twigo-bot.duckdns.org
