# Copy to .env.local and fill in. .env.local is gitignored and must stay
# that way — these are account credentials, not configuration.
#
# Get the first two from https://developer.spotify.com/dashboard
# (register http://127.0.0.1:8888/callback as a redirect URI),
# then run `npm run spotify:auth` to mint the third.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Only needed for the GitHub Pages build: the absolute URL of the deployed
# Vercel function. Left empty in dev, where Vite serves /api/now-playing.
# This one IS public — it ends up in the JS bundle, which is fine.
VITE_NOW_PLAYING_URL=
